{
  "name": "CompanyCam Design Tokens",
  "version": "1.0.0",
  "description": "Design system for CompanyCam iOS/Web clone - professional field service app",
  "colors": {
    "white": "#FFFFFF",
    "black": "#000000",
    "slate50": "#F8FAFC",
    "slate100": "#F1F5F9",
    "slate200": "#E2E8F0",
    "slate300": "#CBD5E1",
    "slate400": "#94A3B8",
    "slate500": "#64748B",
    "slate600": "#475569",
    "slate700": "#334155",
    "slate800": "#1E293B",
    "slate900": "#0F172A",
    "blue50": "#EFF6FF",
    "blue100": "#DBEAFE",
    "blue200": "#BFDBFE",
    "blue500": "#3B82F6",
    "blue600": "#2563EB",
    "blue700": "#1D4ED8",
    "emerald50": "#F0FDF4",
    "emerald100": "#DCFCE7",
    "emerald500": "#10B981",
    "emerald600": "#059669",
    "red50": "#FEF2F2",
    "red100": "#FEE2E2",
    "red500": "#EF4444",
    "red600": "#DC2626",
    "amber50": "#FFFBEB",
    "amber100": "#FEF3C7",
    "amber500": "#F59E0B",
    "amber600": "#D97706"
  },
  "roles": {
    "background": {
      "value": "{colors.white}",
      "description": "Primary app background, screens"
    },
    "surface": {
      "value": "{colors.slate50}",
      "description": "Cards, modals, elevated surfaces"
    },
    "surfaceHover": {
      "value": "{colors.slate100}",
      "description": "Hovered cards, interactive surfaces"
    },
    "border": {
      "value": "{colors.slate200}",
      "description": "Dividers, default borders"
    },
    "borderInput": {
      "value": "{colors.slate300}",
      "description": "Input field borders, focus ring at 500"
    },
    "textPrimary": {
      "value": "{colors.slate900}",
      "description": "Primary text, headings, labels"
    },
    "textSecondary": {
      "value": "{colors.slate600}",
      "description": "Secondary text, descriptions, hints"
    },
    "textMuted": {
      "value": "{colors.slate500}",
      "description": "Placeholder text, disabled text"
    },
    "textInverse": {
      "value": "{colors.white}",
      "description": "Text on colored backgrounds"
    },
    "accent": {
      "value": "{colors.blue600}",
      "description": "Primary action, links, active states"
    },
    "accentHover": {
      "value": "{colors.blue700}",
      "description": "Hover state for accent"
    },
    "accentLight": {
      "value": "{colors.blue50}",
      "description": "Light accent background"
    },
    "success": {
      "value": "{colors.emerald600}",
      "description": "Success states, positive actions"
    },
    "successLight": {
      "value": "{colors.emerald50}",
      "description": "Light success background"
    },
    "warning": {
      "value": "{colors.amber600}",
      "description": "Warning states, caution"
    },
    "warningLight": {
      "value": "{colors.amber50}",
      "description": "Light warning background"
    },
    "danger": {
      "value": "{colors.red600}",
      "description": "Danger, destructive actions"
    },
    "dangerLight": {
      "value": "{colors.red50}",
      "description": "Light danger background"
    },
    "focusRing": {
      "value": "{colors.blue500}",
      "description": "Focus visible ring, 2px width"
    },
    "shadow": {
      "value": "{colors.slate900}",
      "description": "Base color for shadows (opacity varies)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "description": "System font stack for iOS/web consistency"
      },
      "mono": {
        "value": "'Menlo', 'Monaco', 'Courier New', monospace",
        "description": "Monospace for code, numbers"
      }
    },
    "fontSizes": {
      "xs": {
        "value": "12px",
        "lineHeight": "16px",
        "description": "Extra small, secondary labels"
      },
      "sm": {
        "value": "14px",
        "lineHeight": "20px",
        "description": "Small, body text, input"
      },
      "base": {
        "value": "16px",
        "lineHeight": "24px",
        "description": "Body, default size"
      },
      "lg": {
        "value": "18px",
        "lineHeight": "28px",
        "description": "Large, emphasis"
      },
      "xl": {
        "value": "20px",
        "lineHeight": "28px",
        "description": "Extra large, section headers"
      },
      "2xl": {
        "value": "24px",
        "lineHeight": "32px",
        "description": "Screen titles"
      },
      "3xl": {
        "value": "32px",
        "lineHeight": "40px",
        "description": "Major headings"
      }
    },
    "fontWeights": {
      "regular": {
        "value": "400",
        "description": "Regular, body text"
      },
      "medium": {
        "value": "500",
        "description": "Medium, labels, emphasis"
      },
      "semibold": {
        "value": "600",
        "description": "Semibold, button labels, subheadings"
      },
      "bold": {
        "value": "700",
        "description": "Bold, headings"
      }
    },
    "lineHeights": {
      "tight": {
        "value": "1.2"
      },
      "normal": {
        "value": "1.5"
      },
      "relaxed": {
        "value": "1.75"
      }
    }
  },
  "spacing": {
    "base": "4px",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "insets": {
      "xs": "8px",
      "sm": "12px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px"
    },
    "gaps": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px"
    }
  },
  "border": {
    "radius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "999px"
    },
    "widths": {
      "thin": "1px",
      "base": "1px",
      "bold": "2px"
    }
  },
  "shadows": {
    "none": {
      "value": "none"
    },
    "sm": {
      "value": "0 1px 2px 0 rgba(15, 23, 42, 0.05)"
    },
    "md": {
      "value": "0 4px 6px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -1px rgba(15, 23, 42, 0.06)"
    },
    "lg": {
      "value": "0 10px 15px -3px rgba(15, 23, 42, 0.1), 0 4px 6px -2px rgba(15, 23, 42, 0.05)"
    },
    "xl": {
      "value": "0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 10px 10px -5px rgba(15, 23, 42, 0.04)"
    }
  },
  "motion": {
    "duration": {
      "fast": "100ms",
      "base": "150ms",
      "slow": "300ms"
    },
    "easing": {
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeIn": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "layout": {
    "maxContentWidth": "1200px",
    "containerWidths": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "header": {
      "height": "56px"
    },
    "tabBar": {
      "height": "56px"
    },
    "sidebar": {
      "width": "280px"
    },
    "gridGap": "16px",
    "gridColumns": 12
  },
  "accessibility": {
    "focusRingWidth": "2px",
    "focusRingColor": "{roles.focusRing}",
    "focusRingStyle": "solid",
    "focusRingOffset": "2px",
    "minTouchTarget": "44px"
  },
  "pairs": {
    "textOnBackground": {
      "foreground": "{roles.textPrimary}",
      "background": "{roles.background}",
      "description": "Primary text on white background"
    },
    "textOnSurface": {
      "foreground": "{roles.textPrimary}",
      "background": "{roles.surface}",
      "description": "Text on card/surface background"
    },
    "textOnAccent": {
      "foreground": "{roles.textInverse}",
      "background": "{roles.accent}",
      "description": "Text on blue button/background"
    },
    "textOnSuccess": {
      "foreground": "{roles.textInverse}",
      "background": "{roles.success}",
      "description": "Text on success green background"
    },
    "textOnWarning": {
      "foreground": "{roles.textPrimary}",
      "background": "{roles.warningLight}",
      "description": "Text on warning yellow background"
    },
    "textOnDanger": {
      "foreground": "{roles.textInverse}",
      "background": "{roles.danger}",
      "description": "Text on danger red background"
    },
    "inputBorder": {
      "foreground": "{roles.borderInput}",
      "background": "{roles.background}",
      "description": "Input field border on white"
    },
    "inputBorderFocus": {
      "foreground": "{roles.focusRing}",
      "background": "{roles.background}",
      "description": "Input focus ring"
    },
    "secondaryText": {
      "foreground": "{roles.textSecondary}",
      "background": "{roles.background}",
      "description": "Secondary text, descriptions"
    },
    "mutedText": {
      "foreground": "{roles.textMuted}",
      "background": "{roles.background}",
      "description": "Placeholder, disabled text"
    },
    "accentLink": {
      "foreground": "{roles.accent}",
      "background": "{roles.background}",
      "description": "Link text on white"
    }
  }
}
